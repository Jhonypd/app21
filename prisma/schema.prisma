// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id           String   @id @default(uuid())
  nome         String
  email        String?
  auth_id      String
  inativo      Boolean  @default(false)
  data_criacao DateTime @default(now())

  // Relacionamentos
  equipesMembro MembroEquipe[]
  salasCriadas  Sala[]             @relation("SalasCriadasPorPessoa")
  participacoes ParticipanteSala[]
  historias     Historia[]         @relation("HistoriasCriadasPorPessoa")
  votos         Voto[]
}

model Equipe {
  id       String         @id @default(uuid())
  nome     String
  inativo  Boolean        @default(false)
  membros  MembroEquipe[]
  projetos Projeto[]
}

model MembroEquipe {
  id           String  @id @default(uuid())
  pessoa_id    String
  equipe_id    String
  proprietario Boolean @default(false)

  pessoa Pessoa @relation(fields: [pessoa_id], references: [id])
  equipe Equipe @relation(fields: [equipe_id], references: [id])

  @@unique([pessoa_id, equipe_id])
}

model Projeto {
  id         String  @id @default(uuid())
  nome       String
  equipe_id  String
  inativo    Boolean @default(false)
  gerente_id String?
  equipe     Equipe  @relation(fields: [equipe_id], references: [id])
}

model Sala {
  id             String   @id @default(uuid())
  codigo         Int      @unique @default(autoincrement())
  titulo         String
  criado_por     String
  senha          String?
  inativo        Boolean  @default(false)
  data_criacao   DateTime @default(now())
  data_alteracao DateTime @updatedAt()

  // Relações
  proprietario  Pessoa             @relation("SalasCriadasPorPessoa", fields: [criado_por], references: [id])
  participantes ParticipanteSala[]
  historias     Historia[]
  Voto          Voto[]
}

model ParticipanteSala {
  id         String   @id @default(uuid())
  sala_id    String
  pessoa_id  String
  adicionado DateTime @default(now())

  pessoa Pessoa @relation(fields: [pessoa_id], references: [id])
  sala   Sala   @relation(fields: [sala_id], references: [id])

  @@unique([sala_id, pessoa_id])
  @@index([sala_id])
  @@index([pessoa_id])
}

model Historia {
  id             String   @id @default(uuid())
  titulo         String
  descricao      String
  sala_id        String
  criado_por     String
  data_criacao   DateTime @default(now())
  data_alteracao DateTime @updatedAt()

  sala    Sala   @relation(fields: [sala_id], references: [id])
  criador Pessoa @relation("HistoriasCriadasPorPessoa", fields: [criado_por], references: [id])
  votos   Voto[]
}

model Voto {
  id          String @id @default(uuid())
  pessoa_id   String
  sala_id     String
  historia_id String
  valor       Int

  pessoa   Pessoa   @relation(fields: [pessoa_id], references: [id])
  sala     Sala     @relation(fields: [sala_id], references: [id])
  historia Historia @relation(fields: [historia_id], references: [id])

  @@unique([sala_id, historia_id, pessoa_id])
  @@index([sala_id])
  @@index([historia_id])
  @@index([pessoa_id])
}
